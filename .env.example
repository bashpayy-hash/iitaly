# IItaly backend — переменные окружения.
# Скопируй в .env для локального запуска (node сам его не подхватывает —
# запускай через `node -r dotenv/config server.js`, либо экспортируй
# переменные в shell). В Railway эти же ключи задаются в Variables проекта,
# .env туда не коммитится и не нужен.

# --- ИИ-чат и проверка документов (обязательно) ---
ANTHROPIC_API_KEY=sk-ant-...
# Модель. Пусто = claude-sonnet-4-6. Меняется здесь, в коде не зашита.
ANTHROPIC_MODEL=

# --- Кто может обращаться к API из браузера (CORS) ---
# Список источников через запятую. Пустое значение = разрешено ВСЕМ,
# включая чужие сайты; сервер предупредит об этом в логах при старте.
ALLOWED_ORIGINS=https://iitaly.kz,https://www.iitaly.kz,https://iitaly.netlify.app

# --- Личный кабинет / статистика (обязательно для /api/portal/create, /api/stats, /api/reminders/run) ---
# Любая длинная случайная строка — секрет владельца, не показывается клиентам.
STATS_KEY=

# --- Хранилище кабинетов ---
# Каталог, где лежат JSON-файлы клиентов (DATA_DIR/clients/*.json).
# По умолчанию в коде — /data (путь примонтированного Railway volume).
# Если volume не подключён, сервер сам падает на ./.data рядом с кодом —
# но тогда все кабинеты и прогресс пропадают при каждом редеплое.
# Оставь пустым, если volume уже подключён на /data, иначе укажи путь.
# Здесь же теперь лежат events.log, leads.log и orders.log — раньше они
# писались внутрь образа и стирались при каждом деплое вместе со всей
# статистикой воронки.
DATA_DIR=/data

# Ключ шифрования данных клиентов (имя, телефон, почта) на диске.
# Любая длинная случайная строка. ВАЖНО: после первого запуска с этим ключом
# менять его нельзя — старые файлы кабинетов перестанут читаться.
# Без DATA_KEY сервер работает, но хранит данные клиентов открытым текстом.
DATA_KEY=

# --- Telegram-бот напоминаний ---
# 1) Заведи бота через @BotFather в Telegram, получишь токен и имя (@xxx_bot).
# 2) Впиши сюда:
TG_BOT_TOKEN=
TG_BOT_NAME=
# 3) Необязательно, но желательно — случайная строка, которой Telegram будет
#    подписывать вебхуки (X-Telegram-Bot-Api-Secret-Token), чтобы никто
#    посторонний не мог слать поддельные апдейты на /api/tg/webhook.
TG_WEBHOOK_SECRET=
# 4) Твой личный chat_id — сюда придут копии напоминаний и уведомления
#    о новых кабинетах. Быстрый способ узнать: напиши боту любое сообщение,
#    затем открой https://api.telegram.org/bot<TOKEN>/getUpdates и найди
#    "chat":{"id": ...} во входящем апдейте.
TG_CHAT_ID=
# 5) После того как TG_BOT_TOKEN задан (и локально, и в Railway) — один раз
#    выполни `npm run tg:setup`, это зарегистрирует вебхук в Telegram.
#    Без этого шага бот не получит ни одного апдейта, даже с верным токеном.

# --- Публичный URL этого бэкенда (нужен только для npm run tg:setup) ---
BACKEND_URL=https://web-production-9faf3.up.railway.app

# --- Ссылка на кабинет в текстах напоминаний ---
SITE_URL=https://iitaly.netlify.app

# --- Почта (необязательно — без этих трёх писем не будет, только Telegram) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Прочее ---
# PORT задаёт сама Railway — руками не трогать.
# REMINDERS=off отключает суточный планировщик напоминаний (для локальной разработки).
REMINDERS=
