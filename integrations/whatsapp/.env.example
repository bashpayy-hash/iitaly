# Copy values into a PRIVATE server environment, never NEXT_PUBLIC_* or GitHub.
# This scaffold is NOT mounted in server.js. Defaults to off and sends nothing.
WHATSAPP_MODE=off
WHATSAPP_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BUSINESS_PHONE=
# In test mode: 1-5 explicitly consenting test numbers, E.164, comma-separated.
WHATSAPP_TEST_RECIPIENTS=
# Names only after these RU templates have been approved in WhatsApp Manager.
WHATSAPP_TEMPLATE_DUE=iitaly_deadline_ru
WHATSAPP_TEMPLATE_OVERDUE=iitaly_overdue_ru
WHATSAPP_TEMPLATE_DIGEST=iitaly_digest_ru
